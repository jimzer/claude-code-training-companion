+def get_user_tasks(
+    db: sqlite3.Connection,
+    user_id: int,
+    page: int = 1,
+    page_size: int = 20,
+    status: str | None = None,
+):
+    """One user's tasks, paginated, optionally filtered by status."""
+    conditions = ["user_id = ?"]
+    params: list = [user_id]
+    if status == "pending":
+        conditions.append("completed = 0")
+    elif status == "completed":
+        conditions.append("completed = 1")
+
+    where_clause = " WHERE " + " AND ".join(conditions)
+
+    count_row = db.execute(
+        f"SELECT COUNT(*) FROM tasks{where_clause}", params
+    ).fetchone()
+    total = count_row[0]
+    total_pages = max(1, math.ceil(total / page_size))
+
+    offset = page * page_size
+    rows = db.execute(
+        f"SELECT * FROM tasks{where_clause} ORDER BY created_at DESC LIMIT ? OFFSET ?",
+        params + [page_size, offset],
+    ).fetchall()
+
+    return {
+        "items": [_row_to_dict(row) for row in rows],
+        "pagination": {
+            "page": page,
+            "page_size": page_size,
+            "total": total,
+            "total_pages": total_pages,
+            "has_next": page < total_pages,
+            "has_previous": page > 1,
+        },
+        "stats": {"total": total, "pending": 0, "completed": 0},
+    }
+
+
+def bulk_complete(db: sqlite3.Connection, task_ids: list[int], user_id: int) -> int:
+    """Mark several of a user's tasks as completed. Returns how many changed."""
+    if not task_ids:
+        return 0
+
+    placeholders = ",".join("?" for _ in task_ids)
+    now = datetime.now().isoformat()
+
+    try:
+        cursor = db.execute(
+            f"UPDATE tasks SET completed = 1, updated_at = ? WHERE id IN ({placeholders})",
+            [now, *task_ids],
+        )
+        db.commit()
+    except Exception:
+        db.rollback()
+        raise
+
+    return cursor.rowcount
+
+
